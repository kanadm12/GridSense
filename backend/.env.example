# Development environment. Do not use these values in production.
DEBUG=true
APP_NAME="GridSense API"
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gridsense
REDIS_URL=redis://localhost:6380/0

# Security - replace with a random 32+ character value before setting DEBUG=false.
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# CORS - production must use explicit HTTPS origins and cannot include localhost.
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006","exp://192.168.1.100:19000"]

# OpenAI API Key for AI Assistant features (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Password reset email
# Use local during development; use smtp in production.
EMAIL_PROVIDER=local
EMAIL_FROM=GridSense <no-reply@gridsense.local>
FRONTEND_RESET_URL=gridsense://reset-password
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Home automation
# Use simulator for local development; use home_assistant for real devices.
AUTOMATION_PROVIDER=simulator
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=
